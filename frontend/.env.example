# SafarAI environment template — copy to .env and fill in your keys.
# The app degrades gracefully without them:
#  • VITE_API_URL   -> Production Railway backend API server URL
#  • no Groq key    -> the assistant answers from the Railway API or built-in datasets
#  • no Supabase    -> the product runs in local (guest) mode

VITE_API_URL=https://safar-ai-production.up.railway.app
VITE_GROQ_API_KEY=your-groq-api-key
VITE_SUPABASE_URL=https://hqshjdzjhutyzedkbafl.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
